pipeline {
    agent any
    
    environment {
        DOCKERHUB_CREDENTIALS_ID = 'dockerhub'
        PROJECT_NAME = 'django-notes-app'
        IMAGE_TAG = 'latest'
        DOCKERHUB_USERNAME = 'your-dockerhub-username' // or get from credentials
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                dir('django-notes-app') {
                    // Working directory is set for subsequent steps
                }
            }
        }
        
        stage('Build and Test') {
            steps {
                dir('django-notes-app') {
                    script {
                        build()
                    }
                }
            }
        }
        
        stage('Docker Build') {
            steps {
                dir('django-notes-app') {
                    script {
                        docker_build("${PROJECT_NAME}", "${IMAGE_TAG}", "${DOCKERHUB_USERNAME}")
                    }
                }
            }
        }
        
        stage('Docker Push') {
            steps {
                script {
                    docker_push("${PROJECT_NAME}", "${IMAGE_TAG}", "${DOCKERHUB_USERNAME}")
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline completed - cleaning up workspace'
            cleanWs()
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}